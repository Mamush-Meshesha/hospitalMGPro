generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// 1. ADVANCED PRODUCT & UOM ENGINE
// -----------------------------------------------------
model erp_uom_category {
  category_id Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100) // "Weight", "Volume", "Unit"
  uoms        erp_uom[]
}

model erp_uom {
  uom_id      Int              @id @default(autoincrement())
  category_id Int
  name        String           @db.VarChar(50) // "Carton", "Box", "Pill"
  type        String           @default("REFERENCE") // REFERENCE, BIGGER, SMALLER
  ratio       Decimal          @default(1.0) @db.Decimal(10, 4) // Ratio to reference UOM

  category    erp_uom_category @relation(fields: [category_id], references: [category_id])
  products_purchase erp_product[] @relation("PurchaseUOM")
  products_store    erp_product[] @relation("StoreUOM")
}

model erp_product {
  product_id      Int       @id @default(autoincrement())
  concept_id      Int?      @unique // Maps to EMR concept
  sku             String?   @unique @db.VarChar(100)
  barcode         String?   @unique @db.VarChar(100)
  name            String    @db.VarChar(255)
  category        String?
  is_drug         Boolean   @default(true)
  has_expiration  Boolean   @default(true)
  reorder_level   Decimal   @default(0.00) @db.Decimal(10, 2)
  
  purchase_uom_id Int?
  store_uom_id    Int?
  
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  purchase_uom    erp_uom?  @relation("PurchaseUOM", fields: [purchase_uom_id], references: [uom_id])
  store_uom       erp_uom?  @relation("StoreUOM", fields: [store_uom_id], references: [uom_id])

  stock_batches   erp_stock_batch[]
  stock_movements erp_stock_movement[]
  po_items        erp_purchase_order_item[]
  sales_items     erp_sales_receipt_item[]
}

// -----------------------------------------------------
// 2. SUPPLIER & PROCUREMENT
// -----------------------------------------------------
model erp_supplier {
  supplier_id   Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  tax_id        String?   @db.VarChar(100)
  contact_email String?   @db.VarChar(255)
  contact_phone String?   @db.VarChar(100)
  status        String    @default("ACTIVE")

  purchase_orders erp_purchase_order[]
  invoices        erp_invoice[]
}

model erp_purchase_order {
  po_id                  Int       @id @default(autoincrement())
  po_number              String    @unique @db.VarChar(100)
  supplier_id            Int
  status                 String    @default("DRAFT") // DRAFT, APPROVED, SENT, PARTIAL, COMPLETED
  total_amount           Decimal   @default(0.00) @db.Decimal(12, 2)
  created_by             Int       // Maps to EMR user_id
  approved_by            Int?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  supplier               erp_supplier              @relation(fields: [supplier_id], references: [supplier_id])
  items                  erp_purchase_order_item[]
  invoices               erp_invoice[]
}

model erp_purchase_order_item {
  po_item_id         Int       @id @default(autoincrement())
  po_id              Int
  product_id         Int
  quantity_ordered   Decimal   @db.Decimal(10, 2) // In Purchase UOM
  quantity_received  Decimal   @default(0.00) @db.Decimal(10, 2)
  unit_price         Decimal   @db.Decimal(12, 2)

  purchase_order     erp_purchase_order @relation(fields: [po_id], references: [po_id])
  product            erp_product        @relation(fields: [product_id], references: [product_id])
}

// -----------------------------------------------------
// 3. WAREHOUSING, MULTI-BRANCH, & INTERNAL ROUTING
// -----------------------------------------------------
model erp_branch {
  branch_id    Int       @id @default(autoincrement())
  name         String    @db.VarChar(255) // "Main Hospital", "Outpatient"
  location_id  Int?      // Maps to EMR location_id
  warehouses   erp_warehouse[]
  registers    erp_cash_register[]
}

model erp_warehouse {
  warehouse_id Int       @id @default(autoincrement())
  branch_id    Int
  name         String    @db.VarChar(255)
  type         String    @default("INTERNAL") // INTERNAL, SUPPLIER_DOCK, CUSTOMER_ZONE, QUARANTINE

  branch       erp_branch @relation(fields: [branch_id], references: [branch_id])
  zones        erp_warehouse_zone[]
  stock_movements_source erp_stock_movement[] @relation("SourceWarehouse")
  stock_movements_dest   erp_stock_movement[] @relation("DestWarehouse")
}

model erp_warehouse_zone {
  zone_id      Int       @id @default(autoincrement())
  warehouse_id Int
  name         String    @db.VarChar(100)
  warehouse    erp_warehouse @relation(fields: [warehouse_id], references: [warehouse_id])
  bins         erp_warehouse_bin[]
}

model erp_warehouse_bin {
  bin_id       Int       @id @default(autoincrement())
  zone_id      Int
  name         String    @db.VarChar(100)
  zone         erp_warehouse_zone @relation(fields: [zone_id], references: [zone_id])
  batches      erp_stock_batch[]
}

// -----------------------------------------------------
// 4. STOCK LEDGER & BATCH TRACKING (FEFO)
// -----------------------------------------------------
model erp_stock_batch {
  batch_id        Int       @id @default(autoincrement())
  product_id      Int
  bin_id          Int
  batch_number    String    @db.VarChar(100)
  quantity        Decimal   @default(0.00) @db.Decimal(14, 4) // Always in Store UOM
  expiration_date DateTime?
  status          String    @default("ACTIVE") // ACTIVE, QUARANTINE, EXPIRED, RECALLED
  created_at      DateTime  @default(now())

  product         erp_product       @relation(fields: [product_id], references: [product_id])
  bin             erp_warehouse_bin @relation(fields: [bin_id], references: [bin_id])
}

// THE IMMUTABLE AUDIT TRAIL
model erp_stock_movement {
  movement_id     Int       @id @default(autoincrement())
  product_id      Int
  source_wh_id    Int?
  dest_wh_id      Int?
  quantity        Decimal   @db.Decimal(14, 4)
  reference       String?   @db.VarChar(255) // "PO-123", "Sale-456", "Adjustment-789"
  date_moved      DateTime  @default(now())
  created_by      Int       // Maps to EMR user_id

  product         erp_product   @relation(fields: [product_id], references: [product_id])
  source_warehouse erp_warehouse? @relation("SourceWarehouse", fields: [source_wh_id], references: [warehouse_id])
  dest_warehouse   erp_warehouse? @relation("DestWarehouse", fields: [dest_wh_id], references: [warehouse_id])
}

// -----------------------------------------------------
// 5. POINT OF SALE (POS) & BILLING
// -----------------------------------------------------
model erp_cash_register {
  register_id     Int       @id @default(autoincrement())
  branch_id       Int
  opened_by       Int       // EMR user_id
  opened_at       DateTime  @default(now())
  closed_at       DateTime?
  opening_balance Decimal   @default(0.00) @db.Decimal(12, 2)
  closing_balance Decimal?  @db.Decimal(12, 2)
  status          String    @default("OPEN") // OPEN, CLOSED

  branch          erp_branch @relation(fields: [branch_id], references: [branch_id])
  sales           erp_sales_receipt[]
}

model erp_sales_receipt {
  receipt_id      Int       @id @default(autoincrement())
  register_id     Int
  patient_id      Int?      // Maps to EMR patient
  total_amount    Decimal   @default(0.00) @db.Decimal(12, 2)
  payment_method  String    @default("CASH") // CASH, INSURANCE, CARD
  created_at      DateTime  @default(now())
  created_by      Int

  register        erp_cash_register @relation(fields: [register_id], references: [register_id])
  items           erp_sales_receipt_item[]
}

model erp_sales_receipt_item {
  receipt_item_id Int       @id @default(autoincrement())
  receipt_id      Int
  product_id      Int
  quantity        Decimal   @db.Decimal(10, 2)
  unit_price      Decimal   @db.Decimal(12, 2)
  discount        Decimal   @default(0.00) @db.Decimal(12, 2) // Insurance or manual
  
  receipt         erp_sales_receipt @relation(fields: [receipt_id], references: [receipt_id])
  product         erp_product       @relation(fields: [product_id], references: [product_id])
}

// -----------------------------------------------------
// 6. ACCOUNTS PAYABLE (Invoicing Suppliers)
// -----------------------------------------------------
model erp_invoice {
  invoice_id     Int       @id @default(autoincrement())
  po_id          Int
  supplier_id    Int
  invoice_number String?   @db.VarChar(100)
  total_amount   Decimal   @db.Decimal(12, 2)
  status         String    @default("UNPAID") // UNPAID, PAID
  created_at     DateTime  @default(now())

  purchase_order erp_purchase_order @relation(fields: [po_id], references: [po_id])
  supplier       erp_supplier       @relation(fields: [supplier_id], references: [supplier_id])
  payments       erp_payment[]
}

model erp_payment {
  payment_id     Int       @id @default(autoincrement())
  invoice_id     Int
  amount_paid    Decimal   @db.Decimal(12, 2)
  payment_method String    @db.VarChar(50)
  payment_date   DateTime  @default(now())

  invoice        erp_invoice @relation(fields: [invoice_id], references: [invoice_id])
}
