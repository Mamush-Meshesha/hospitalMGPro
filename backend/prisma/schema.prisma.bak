generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model allergy {
  allergy_id              Int       @id @default(autoincrement())
  patient_id              Int
  severity_concept_id     Int?
  coded_allergen          Int
  non_coded_allergen      String?
  allergen_type           String
  comments                String?
  creator                 Int
  date_created            DateTime
  changed_by              Int?
  date_changed            DateTime?
  voided                  Boolean
  voided_by               Int?
  date_voided             DateTime?
  void_reason             String?
  uuid                    String?
  form_namespace_and_path String?
  encounter_id            Int?

  users_allergy_changed_by_fk                             users?             @relation("allergy_changed_by_fk", fields: [changed_by], references: [user_id])
  concept_allergy_coded_allergen_fk                       concept            @relation("allergy_coded_allergen_fk", fields: [coded_allergen], references: [concept_id])
  users_allergy_creator_fk                                users              @relation("allergy_creator_fk", fields: [creator], references: [user_id])
  encounter_allergy_encounter_id_fk                       encounter?         @relation("allergy_encounter_id_fk", fields: [encounter_id], references: [encounter_id])
  patient_allergy_patient_id_fk                           patient            @relation("allergy_patient_id_fk", fields: [patient_id], references: [patient_id])
  concept_allergy_severity_concept_id_fk                  concept?           @relation("allergy_severity_concept_id_fk", fields: [severity_concept_id], references: [concept_id])
  users_allergy_voided_by_fk                              users?             @relation("allergy_voided_by_fk", fields: [voided_by], references: [user_id])
  reverse_allergy_reaction_allergy_reaction_allergy_id_fk allergy_reaction[] @relation("allergy_reaction_allergy_id_fk")
}

model allergy_reaction {
  allergy_reaction_id Int     @id @default(autoincrement())
  allergy_id          Int
  reaction_concept_id Int
  reaction_non_coded  String?
  uuid                String?

  allergy_allergy_reaction_allergy_id_fk          allergy @relation("allergy_reaction_allergy_id_fk", fields: [allergy_id], references: [allergy_id])
  concept_allergy_reaction_reaction_concept_id_fk concept @relation("allergy_reaction_reaction_concept_id_fk", fields: [reaction_concept_id], references: [concept_id])
}

model care_setting {
  care_setting_id   Int       @id @default(autoincrement())
  name              String
  description       String?
  care_setting_type String
  creator           Int
  date_created      DateTime
  retired           Boolean
  retired_by        Int?
  date_retired      DateTime?
  retire_reason     String?
  changed_by        Int?
  date_changed      DateTime?
  uuid              String

  users_care_setting_changed_by      users?   @relation("care_setting_changed_by", fields: [changed_by], references: [user_id])
  users_care_setting_creator         users    @relation("care_setting_creator", fields: [creator], references: [user_id])
  users_care_setting_retired_by      users?   @relation("care_setting_retired_by", fields: [retired_by], references: [user_id])
  reverse_orders_orders_care_setting orders[] @relation("orders_care_setting")
}

model clob_datatype_storage {
  id    Int    @id @default(autoincrement())
  uuid  String
  value String
}

model cohort {
  cohort_id    Int       @id @default(autoincrement())
  name         String
  description  String?
  creator      Int
  date_created DateTime
  voided       Boolean
  voided_by    Int?
  date_voided  DateTime?
  void_reason  String?
  changed_by   Int?
  date_changed DateTime?
  uuid         String

  users_cohort_creator                users           @relation("cohort_creator", fields: [creator], references: [user_id])
  users_user_who_changed_cohort       users?          @relation("user_who_changed_cohort", fields: [changed_by], references: [user_id])
  users_user_who_voided_cohort        users?          @relation("user_who_voided_cohort", fields: [voided_by], references: [user_id])
  reverse_cohort_member_parent_cohort cohort_member[] @relation("parent_cohort")
}

model cohort_member {
  cohort_id        Int
  patient_id       Int
  cohort_member_id Int       @id @default(autoincrement())
  start_date       DateTime?
  end_date         DateTime?
  creator          Int
  date_created     DateTime
  voided           Boolean
  voided_by        Int?
  date_voided      DateTime?
  void_reason      String?
  uuid             String

  users_cohort_member_creator users   @relation("cohort_member_creator", fields: [creator], references: [user_id])
  patient_member_patient      patient @relation("member_patient", fields: [patient_id], references: [patient_id])
  cohort_parent_cohort        cohort  @relation("parent_cohort", fields: [cohort_id], references: [cohort_id])
}

model concept {
  concept_id    Int       @id @default(autoincrement())
  retired       Boolean
  short_name    String?
  description   String?
  form_text     String?
  datatype_id   Int
  class_id      Int
  is_set        Boolean
  creator       Int
  date_created  DateTime
  version       String?
  changed_by    Int?
  date_changed  DateTime?
  retired_by    Int?
  date_retired  DateTime?
  retire_reason String?
  uuid          String

  concept_class_concept_classes                                          concept_class              @relation("concept_classes", fields: [class_id], references: [concept_class_id])
  users_concept_creator                                                  users                      @relation("concept_creator", fields: [creator], references: [user_id])
  concept_datatype_concept_datatypes                                     concept_datatype           @relation("concept_datatypes", fields: [datatype_id], references: [concept_datatype_id])
  users_user_who_changed_concept                                         users?                     @relation("user_who_changed_concept", fields: [changed_by], references: [user_id])
  users_user_who_retired_concept                                         users?                     @relation("user_who_retired_concept", fields: [retired_by], references: [user_id])
  reverse_allergy_allergy_coded_allergen_fk                              allergy[]                  @relation("allergy_coded_allergen_fk")
  reverse_allergy_allergy_severity_concept_id_fk                         allergy[]                  @relation("allergy_severity_concept_id_fk")
  reverse_allergy_reaction_allergy_reaction_reaction_concept_id_fk       allergy_reaction[]         @relation("allergy_reaction_reaction_concept_id_fk")
  reverse_concept_answer_answer                                          concept_answer[]           @relation("answer")
  reverse_concept_answer_answers_for_concept                             concept_answer[]           @relation("answers_for_concept")
  reverse_concept_attribute_concept_attribute_concept_fk                 concept_attribute[]        @relation("concept_attribute_concept_fk")
  reverse_concept_complex_concept_attributes                             concept_complex[]          @relation("concept_attributes")
  reverse_concept_description_description_for_concept                    concept_description[]      @relation("description_for_concept")
  reverse_concept_name_name_for_concept                                  concept_name[]             @relation("name_for_concept")
  reverse_concept_numeric_numeric_attributes                             concept_numeric[]          @relation("numeric_attributes")
  reverse_concept_proposal_concept_for_proposal                          concept_proposal[]         @relation("concept_for_proposal")
  reverse_concept_proposal_proposal_obs_concept_id                       concept_proposal[]         @relation("proposal_obs_concept_id")
  reverse_concept_reference_map_map_for_concept                          concept_reference_map[]    @relation("map_for_concept")
  reverse_concept_set_has_a                                              concept_set[]              @relation("has_a")
  reverse_concept_state_conversion_concept_triggers_conversion           concept_state_conversion[] @relation("concept_triggers_conversion")
  reverse_conditions_condition_condition_coded_fk                        conditions[]               @relation("condition_condition_coded_fk")
  reverse_drug_dosage_form_concept                                       drug[]                     @relation("dosage_form_concept")
  reverse_drug_drug_dose_limit_units_fk                                  drug[]                     @relation("drug_dose_limit_units_fk")
  reverse_drug_primary_drug_concept                                      drug[]                     @relation("primary_drug_concept")
  reverse_drug_route_concept                                             drug[]                     @relation("route_concept")
  reverse_drug_ingredient_drug_ingredient_ingredient_id_fk               drug_ingredient[]          @relation("drug_ingredient_ingredient_id_fk")
  reverse_drug_ingredient_drug_ingredient_units_fk                       drug_ingredient[]          @relation("drug_ingredient_units_fk")
  reverse_drug_order_drug_order_dose_units                               drug_order[]               @relation("drug_order_dose_units")
  reverse_drug_order_drug_order_duration_units_fk                        drug_order[]               @relation("drug_order_duration_units_fk")
  reverse_drug_order_drug_order_quantity_units                           drug_order[]               @relation("drug_order_quantity_units")
  reverse_drug_order_drug_order_route_fk                                 drug_order[]               @relation("drug_order_route_fk")
  reverse_encounter_diagnosis_encounter_diagnosis_coded_fk               encounter_diagnosis[]      @relation("encounter_diagnosis_coded_fk")
  reverse_field_concept_for_field                                        field[]                    @relation("concept_for_field")
  reverse_field_answer_field_answer_concept                              field_answer[]             @relation("field_answer_concept")
  reverse_location_location_type_fk                                      location[]                 @relation("location_type_fk")
  reverse_medication_dispense_medication_dispense_concept_fk             medication_dispense[]      @relation("medication_dispense_concept_fk")
  reverse_medication_dispense_medication_dispense_dose_units_fk          medication_dispense[]      @relation("medication_dispense_dose_units_fk")
  reverse_medication_dispense_medication_dispense_quantity_units_fk      medication_dispense[]      @relation("medication_dispense_quantity_units_fk")
  reverse_medication_dispense_medication_dispense_route_fk               medication_dispense[]      @relation("medication_dispense_route_fk")
  reverse_medication_dispense_medication_dispense_status_fk              medication_dispense[]      @relation("medication_dispense_status_fk")
  reverse_medication_dispense_medication_dispense_status_reason_fk       medication_dispense[]      @relation("medication_dispense_status_reason_fk")
  reverse_medication_dispense_medication_dispense_substitution_reason_fk medication_dispense[]      @relation("medication_dispense_substitution_reason_fk")
  reverse_medication_dispense_medication_dispense_substitution_type_fk   medication_dispense[]      @relation("medication_dispense_substitution_type_fk")
  reverse_medication_dispense_medication_dispense_type_fk                medication_dispense[]      @relation("medication_dispense_type_fk")
  reverse_obs_answer_concept                                             obs[]                      @relation("answer_concept")
  reverse_obs_obs_concept                                                obs[]                      @relation("obs_concept")
  reverse_order_frequency_order_frequency_concept_id_fk                  order_frequency[]          @relation("order_frequency_concept_id_fk")
  reverse_order_group_order_group_order_group_reason_fk                  order_group[]              @relation("order_group_order_group_reason_fk")
  reverse_order_set_category_order_set_fk                                order_set[]                @relation("category_order_set_fk")
  reverse_order_set_member_order_set_member_concept_id_fk                order_set_member[]         @relation("order_set_member_concept_id_fk")
  reverse_orders_discontinued_because                                    orders[]                   @relation("discontinued_because")
  reverse_patient_program_patient_program_outcome_concept_id_fk          patient_program[]          @relation("patient_program_outcome_concept_id_fk")
  reverse_person_person_died_because                                     person[]                   @relation("person_died_because")
  reverse_program_program_concept                                        program[]                  @relation("program_concept")
  reverse_program_program_outcomes_concept_id_fk                         program[]                  @relation("program_outcomes_concept_id_fk")
  reverse_program_workflow_workflow_concept                              program_workflow[]         @relation("workflow_concept")
  reverse_program_workflow_state_state_concept                           program_workflow_state[]   @relation("state_concept")
  reverse_provider_provider_role_id_fk                                   provider[]                 @relation("provider_role_id_fk")
  reverse_provider_provider_speciality_id_fk                             provider[]                 @relation("provider_speciality_id_fk")
  reverse_referral_order_referral_order_location_fk                      referral_order[]           @relation("referral_order_location_fk")
  reverse_referral_order_referral_order_specimen_source_fk               referral_order[]           @relation("referral_order_specimen_source_fk")
  reverse_test_order_test_order_location_fk                              test_order[]               @relation("test_order_location_fk")
  reverse_test_order_test_order_specimen_source_fk                       test_order[]               @relation("test_order_specimen_source_fk")
  reverse_visit_visit_indication_concept_fk                              visit[]                    @relation("visit_indication_concept_fk")
}

model concept_answer {
  concept_answer_id Int      @id @default(autoincrement())
  concept_id        Int
  answer_concept    Int?
  answer_drug       Int?
  creator           Int
  date_created      DateTime
  sort_weight       Float?
  uuid              String

  concept_answer              concept? @relation("answer", fields: [answer_concept], references: [concept_id])
  drug_answer_answer_drug_fk  drug?    @relation("answer_answer_drug_fk", fields: [answer_drug], references: [drug_id])
  users_answer_creator        users    @relation("answer_creator", fields: [creator], references: [user_id])
  concept_answers_for_concept concept  @relation("answers_for_concept", fields: [concept_id], references: [concept_id])
}

model concept_attribute {
  concept_attribute_id Int       @id @default(autoincrement())
  concept_id           Int
  attribute_type_id    Int
  value_reference      String
  uuid                 String
  creator              Int
  date_created         DateTime
  changed_by           Int?
  date_changed         DateTime?
  voided               Boolean
  voided_by            Int?
  date_voided          DateTime?
  void_reason          String?

  concept_attribute_type_concept_attribute_attribute_type_id_fk concept_attribute_type @relation("concept_attribute_attribute_type_id_fk", fields: [attribute_type_id], references: [concept_attribute_type_id])
  users_concept_attribute_changed_by_fk                         users?                 @relation("concept_attribute_changed_by_fk", fields: [changed_by], references: [user_id])
  concept_concept_attribute_concept_fk                          concept                @relation("concept_attribute_concept_fk", fields: [concept_id], references: [concept_id])
  users_concept_attribute_creator_fk                            users                  @relation("concept_attribute_creator_fk", fields: [creator], references: [user_id])
  users_concept_attribute_voided_by_fk                          users?                 @relation("concept_attribute_voided_by_fk", fields: [voided_by], references: [user_id])
}

model concept_attribute_type {
  concept_attribute_type_id Int       @id @default(autoincrement())
  name                      String
  description               String?
  datatype                  String?
  datatype_config           String?
  preferred_handler         String?
  handler_config            String?
  min_occurs                Int
  max_occurs                Int?
  creator                   Int
  date_created              DateTime
  changed_by                Int?
  date_changed              DateTime?
  retired                   Boolean
  retired_by                Int?
  date_retired              DateTime?
  retire_reason             String?
  uuid                      String

  users_concept_attribute_type_changed_by_fk                       users?              @relation("concept_attribute_type_changed_by_fk", fields: [changed_by], references: [user_id])
  users_concept_attribute_type_creator_fk                          users               @relation("concept_attribute_type_creator_fk", fields: [creator], references: [user_id])
  users_concept_attribute_type_retired_by_fk                       users?              @relation("concept_attribute_type_retired_by_fk", fields: [retired_by], references: [user_id])
  reverse_concept_attribute_concept_attribute_attribute_type_id_fk concept_attribute[] @relation("concept_attribute_attribute_type_id_fk")
}

model concept_class {
  concept_class_id Int       @id @default(autoincrement())
  name             String
  description      String?
  creator          Int
  date_created     DateTime
  retired          Boolean
  retired_by       Int?
  date_retired     DateTime?
  retire_reason    String?
  uuid             String
  date_changed     DateTime?
  changed_by       Int?

  users_concept_class_changed_by                                                      users?                 @relation("concept_class_changed_by", fields: [changed_by], references: [user_id])
  users_concept_class_creator                                                         users                  @relation("concept_class_creator", fields: [creator], references: [user_id])
  users_user_who_retired_concept_class                                                users?                 @relation("user_who_retired_concept_class", fields: [retired_by], references: [user_id])
  reverse_concept_concept_classes                                                     concept[]              @relation("concept_classes")
  reverse_order_type_class_map_fk_order_type_class_map_concept_class_concept_class_id order_type_class_map[] @relation("fk_order_type_class_map_concept_class_concept_class_id")
}

model concept_complex {
  concept_id Int     @id
  handler    String?

  concept_concept_attributes concept @relation("concept_attributes", fields: [concept_id], references: [concept_id])
}

model concept_datatype {
  concept_datatype_id Int       @id @default(autoincrement())
  name                String
  hl7_abbreviation    String?
  description         String?
  creator             Int
  date_created        DateTime
  retired             Boolean
  retired_by          Int?
  date_retired        DateTime?
  retire_reason       String?
  uuid                String

  users_concept_datatype_creator          users     @relation("concept_datatype_creator", fields: [creator], references: [user_id])
  users_user_who_retired_concept_datatype users?    @relation("user_who_retired_concept_datatype", fields: [retired_by], references: [user_id])
  reverse_concept_concept_datatypes       concept[] @relation("concept_datatypes")
}

model concept_description {
  concept_description_id Int       @id @default(autoincrement())
  concept_id             Int
  description            String
  locale                 String
  creator                Int
  date_created           DateTime
  changed_by             Int?
  date_changed           DateTime?
  uuid                   String

  concept_description_for_concept    concept @relation("description_for_concept", fields: [concept_id], references: [concept_id])
  users_user_who_changed_description users?  @relation("user_who_changed_description", fields: [changed_by], references: [user_id])
  users_user_who_created_description users   @relation("user_who_created_description", fields: [creator], references: [user_id])
}

model concept_map_type {
  concept_map_type_id Int       @id @default(autoincrement())
  name                String
  description         String?
  creator             Int
  date_created        DateTime
  changed_by          Int?
  date_changed        DateTime?
  is_hidden           Boolean
  retired             Boolean
  retired_by          Int?
  date_retired        DateTime?
  retire_reason       String?
  uuid                String

  users_mapped_user_changed_concept_map_type                              users?                       @relation("mapped_user_changed_concept_map_type", fields: [changed_by], references: [user_id])
  users_mapped_user_creator_concept_map_type                              users                        @relation("mapped_user_creator_concept_map_type", fields: [creator], references: [user_id])
  users_mapped_user_retired_concept_map_type                              users?                       @relation("mapped_user_retired_concept_map_type", fields: [retired_by], references: [user_id])
  reverse_concept_reference_map_mapped_concept_map_type                   concept_reference_map[]      @relation("mapped_concept_map_type")
  reverse_concept_reference_term_map_mapped_concept_map_type_ref_term_map concept_reference_term_map[] @relation("mapped_concept_map_type_ref_term_map")
  reverse_drug_reference_map_concept_map_type_for_drug_reference_map      drug_reference_map[]         @relation("concept_map_type_for_drug_reference_map")
}

model concept_name {
  concept_name_id   Int       @id @default(autoincrement())
  concept_id        Int?
  name              String
  locale            String
  locale_preferred  Boolean?
  creator           Int
  date_created      DateTime
  concept_name_type String?
  voided            Boolean
  voided_by         Int?
  date_voided       DateTime?
  void_reason       String?
  uuid              String
  date_changed      DateTime?
  changed_by        Int?

  users_concept_name_changed_by                                 users?                 @relation("concept_name_changed_by", fields: [changed_by], references: [user_id])
  concept_name_for_concept                                      concept?               @relation("name_for_concept", fields: [concept_id], references: [concept_id])
  users_user_who_created_name                                   users                  @relation("user_who_created_name", fields: [creator], references: [user_id])
  users_user_who_voided_this_name                               users?                 @relation("user_who_voided_this_name", fields: [voided_by], references: [user_id])
  reverse_concept_name_tag_map_mapped_concept_name              concept_name_tag_map[] @relation("mapped_concept_name")
  reverse_conditions_condition_condition_coded_name_fk          conditions[]           @relation("condition_condition_coded_name_fk")
  reverse_encounter_diagnosis_encounter_diagnosis_coded_name_fk encounter_diagnosis[]  @relation("encounter_diagnosis_coded_name_fk")
  reverse_obs_obs_name_of_coded_value                           obs[]                  @relation("obs_name_of_coded_value")
}

model concept_name_tag {
  concept_name_tag_id Int       @id @default(autoincrement())
  tag                 String
  description         String?
  creator             Int
  date_created        DateTime
  voided              Boolean
  voided_by           Int?
  date_voided         DateTime?
  void_reason         String?
  uuid                String
  date_changed        DateTime?
  changed_by          Int?

  users_concept_name_tag_changed_by                            users?                     @relation("concept_name_tag_changed_by", fields: [changed_by], references: [user_id])
  reverse_concept_name_tag_map_mapped_concept_name_tag         concept_name_tag_map[]     @relation("mapped_concept_name_tag")
  reverse_concept_proposal_tag_map_mapped_concept_proposal_tag concept_proposal_tag_map[] @relation("mapped_concept_proposal_tag")
}

model concept_name_tag_map {
  id                  Int @id @default(autoincrement())
  concept_name_id     Int
  concept_name_tag_id Int

  concept_name_mapped_concept_name         concept_name     @relation("mapped_concept_name", fields: [concept_name_id], references: [concept_name_id])
  concept_name_tag_mapped_concept_name_tag concept_name_tag @relation("mapped_concept_name_tag", fields: [concept_name_tag_id], references: [concept_name_tag_id])
}

model concept_numeric {
  concept_id        Int      @id
  hi_absolute       Float?
  hi_critical       Float?
  hi_normal         Float?
  low_absolute      Float?
  low_critical      Float?
  low_normal        Float?
  units             String?
  allow_decimal     Boolean?
  display_precision Int?

  concept_numeric_attributes concept @relation("numeric_attributes", fields: [concept_id], references: [concept_id])
}

model concept_proposal {
  concept_proposal_id Int       @id @default(autoincrement())
  concept_id          Int?
  encounter_id        Int?
  original_text       String
  final_text          String?
  obs_id              Int?
  obs_concept_id      Int?
  state               String
  comments            String?
  creator             Int
  date_created        DateTime
  changed_by          Int?
  date_changed        DateTime?
  locale              String
  uuid                String

  concept_concept_for_proposal                             concept?                   @relation("concept_for_proposal", fields: [concept_id], references: [concept_id])
  encounter_encounter_for_proposal                         encounter?                 @relation("encounter_for_proposal", fields: [encounter_id], references: [encounter_id])
  concept_proposal_obs_concept_id                          concept?                   @relation("proposal_obs_concept_id", fields: [obs_concept_id], references: [concept_id])
  obs_proposal_obs_id                                      obs?                       @relation("proposal_obs_id", fields: [obs_id], references: [obs_id])
  users_user_who_changed_proposal                          users?                     @relation("user_who_changed_proposal", fields: [changed_by], references: [user_id])
  users_user_who_created_proposal                          users                      @relation("user_who_created_proposal", fields: [creator], references: [user_id])
  reverse_concept_proposal_tag_map_mapped_concept_proposal concept_proposal_tag_map[] @relation("mapped_concept_proposal")
}

model concept_proposal_tag_map {
  id                  Int @id @default(autoincrement())
  concept_proposal_id Int
  concept_name_tag_id Int

  concept_proposal_mapped_concept_proposal     concept_proposal @relation("mapped_concept_proposal", fields: [concept_proposal_id], references: [concept_proposal_id])
  concept_name_tag_mapped_concept_proposal_tag concept_name_tag @relation("mapped_concept_proposal_tag", fields: [concept_name_tag_id], references: [concept_name_tag_id])
}

model concept_reference_map {
  concept_map_id            Int       @id @default(autoincrement())
  concept_reference_term_id Int
  concept_map_type_id       Int
  creator                   Int
  date_created              DateTime
  concept_id                Int
  changed_by                Int?
  date_changed              DateTime?
  uuid                      String

  users_map_creator                                    users                  @relation("map_creator", fields: [creator], references: [user_id])
  concept_map_for_concept                              concept                @relation("map_for_concept", fields: [concept_id], references: [concept_id])
  concept_map_type_mapped_concept_map_type             concept_map_type       @relation("mapped_concept_map_type", fields: [concept_map_type_id], references: [concept_map_type_id])
  concept_reference_term_mapped_concept_reference_term concept_reference_term @relation("mapped_concept_reference_term", fields: [concept_reference_term_id], references: [concept_reference_term_id])
