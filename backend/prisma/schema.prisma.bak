  reverse_visit_visit_creator_fk                                              visit[]                        @relation("visit_creator_fk")
  reverse_visit_visit_voided_by_fk                                            visit[]                        @relation("visit_voided_by_fk")
  reverse_visit_attribute_visit_attribute_changed_by_fk                       visit_attribute[]              @relation("visit_attribute_changed_by_fk")
  reverse_visit_attribute_visit_attribute_creator_fk                          visit_attribute[]              @relation("visit_attribute_creator_fk")
  reverse_visit_attribute_visit_attribute_voided_by_fk                        visit_attribute[]              @relation("visit_attribute_voided_by_fk")
  reverse_visit_attribute_type_visit_attribute_type_changed_by_fk             visit_attribute_type[]         @relation("visit_attribute_type_changed_by_fk")
  reverse_visit_attribute_type_visit_attribute_type_creator_fk                visit_attribute_type[]         @relation("visit_attribute_type_creator_fk")
  reverse_visit_attribute_type_visit_attribute_type_retired_by_fk             visit_attribute_type[]         @relation("visit_attribute_type_retired_by_fk")
  reverse_visit_type_visit_type_changed_by                                    visit_type[]                   @relation("visit_type_changed_by")
  reverse_visit_type_visit_type_creator                                       visit_type[]                   @relation("visit_type_creator")
  reverse_visit_type_visit_type_retired_by                                    visit_type[]                   @relation("visit_type_retired_by")
}

model visit {
  visit_id              Int       @id @default(autoincrement())
  patient_id            Int
  visit_type_id         Int
  date_started          DateTime
  date_stopped          DateTime?
  indication_concept_id Int?
  location_id           Int?
  creator               Int
  date_created          DateTime
  changed_by            Int?
  date_changed          DateTime?
  voided                Boolean
  voided_by             Int?
  date_voided           DateTime?
  void_reason           String?
  uuid                  String

  users_visit_changed_by_fk                        users?            @relation("visit_changed_by_fk", fields: [changed_by], references: [user_id])
  users_visit_creator_fk                           users             @relation("visit_creator_fk", fields: [creator], references: [user_id])
  concept_visit_indication_concept_fk              concept?          @relation("visit_indication_concept_fk", fields: [indication_concept_id], references: [concept_id])
  location_visit_location_fk                       location?         @relation("visit_location_fk", fields: [location_id], references: [location_id])
  patient_visit_patient_fk                         patient           @relation("visit_patient_fk", fields: [patient_id], references: [patient_id])
  visit_type_visit_type_fk                         visit_type        @relation("visit_type_fk", fields: [visit_type_id], references: [visit_type_id])
  users_visit_voided_by_fk                         users?            @relation("visit_voided_by_fk", fields: [voided_by], references: [user_id])
  reverse_encounter_encounter_visit_id_fk          encounter[]       @relation("encounter_visit_id_fk")
  reverse_visit_attribute_visit_attribute_visit_fk visit_attribute[] @relation("visit_attribute_visit_fk")
}

model visit_attribute {
  visit_attribute_id Int       @id @default(autoincrement())
  visit_id           Int
  attribute_type_id  Int
  value_reference    String
  uuid               String
  creator            Int
  date_created       DateTime
  changed_by         Int?
  date_changed       DateTime?
  voided             Boolean
  voided_by          Int?
  date_voided        DateTime?
  void_reason        String?

  visit_attribute_type_visit_attribute_attribute_type_id_fk visit_attribute_type @relation("visit_attribute_attribute_type_id_fk", fields: [attribute_type_id], references: [visit_attribute_type_id])
  users_visit_attribute_changed_by_fk                       users?               @relation("visit_attribute_changed_by_fk", fields: [changed_by], references: [user_id])
  users_visit_attribute_creator_fk                          users                @relation("visit_attribute_creator_fk", fields: [creator], references: [user_id])
  visit_visit_attribute_visit_fk                            visit                @relation("visit_attribute_visit_fk", fields: [visit_id], references: [visit_id])
  users_visit_attribute_voided_by_fk                        users?               @relation("visit_attribute_voided_by_fk", fields: [voided_by], references: [user_id])
}

model visit_attribute_type {
  visit_attribute_type_id Int       @id @default(autoincrement())
  name                    String
  description             String?
  datatype                String?
  datatype_config         String?
  preferred_handler       String?
  handler_config          String?
  min_occurs              Int
  max_occurs              Int?
  creator                 Int
  date_created            DateTime
  changed_by              Int?
  date_changed            DateTime?
  retired                 Boolean
  retired_by              Int?
  date_retired            DateTime?
  retire_reason           String?
  uuid                    String

  users_visit_attribute_type_changed_by_fk                     users?            @relation("visit_attribute_type_changed_by_fk", fields: [changed_by], references: [user_id])
  users_visit_attribute_type_creator_fk                        users             @relation("visit_attribute_type_creator_fk", fields: [creator], references: [user_id])
  users_visit_attribute_type_retired_by_fk                     users?            @relation("visit_attribute_type_retired_by_fk", fields: [retired_by], references: [user_id])
  reverse_visit_attribute_visit_attribute_attribute_type_id_fk visit_attribute[] @relation("visit_attribute_attribute_type_id_fk")
}

model visit_type {
  visit_type_id Int       @id @default(autoincrement())
  name          String
  description   String?
  creator       Int
  date_created  DateTime
  changed_by    Int?
  date_changed  DateTime?
  retired       Boolean
  retired_by    Int?
  date_retired  DateTime?
  retire_reason String?
  uuid          String

  users_visit_type_changed_by users?  @relation("visit_type_changed_by", fields: [changed_by], references: [user_id])
  users_visit_type_creator    users   @relation("visit_type_creator", fields: [creator], references: [user_id])
  users_visit_type_retired_by users?  @relation("visit_type_retired_by", fields: [retired_by], references: [user_id])
  reverse_visit_visit_type_fk visit[] @relation("visit_type_fk")
}
